<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================================
                        SPRING XML CONFIGURATION BLUEPRINT
    ============================================================================
    * xmlns: Defines the Spring Beans vocabulary/namespace.
    * xsi:schemaLocation: Maps the Spring namespace to its schema definition (XSD)
      inside the spring-beans jar for grammar validation & IDE auto-complete.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
               http://www.springframework.org/schema/beans
               http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        ========================================================================
        STEP 1: DEFINE INDIVIDUAL COURSE BEANS (DEPENDENCIES)
        ========================================================================
        - 'id': Unique identifier (nickname) for the bean in the container.
        - 'class': Fully qualified class name. Spring instantiates this using
                   reflection (calling the default no-arg constructor).
    -->
    <bean id="MyJavaCourse" class="org.example.javaCourse.JavaCourse"/>
    <bean id="MyPythonCourse" class="org.example.pythonCourse.PythonCourse"/>
    <bean id="MyJavaScript" class="org.example.javaScript.JS"/>

    <!--
        ========================================================================
        STEP 2: DEPENDENCY INJECTION VIA CONSTRUCTOR (<constructor-arg>)
        ========================================================================
        CourseBuy constructor signature: CourseBuy(Courses courses, int takeAmount)
        
        - 'ref': Pass another Spring Bean as a parameter by its bean 'id'.
        - 'value': Pass raw literal values (int, String, double, boolean).
    -->

    <!-- CourseBuy configured for Java Course -->
    <bean id="JavaCourseBuy" class="org.example.courseBuy.CourseBuy">
        <constructor-arg ref="MyJavaCourse"/>
        <constructor-arg value="200"/>
    </bean>

    <!-- CourseBuy configured for Python Course -->
    <bean id="PythonCourseBuy" class="org.example.courseBuy.CourseBuy">
        <constructor-arg ref="MyPythonCourse"/>
        <constructor-arg value="150"/>
    </bean>

    <!-- CourseBuy configured for JavaScript Course -->
    <bean id="JavaScript" class="org.example.courseBuy.CourseBuy">
        <constructor-arg ref="MyJavaScript"/>
        <constructor-arg value="400"/>
    </bean>

</beans>
